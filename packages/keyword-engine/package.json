{
  "name": "@news-agg/keyword-engine",
  "version": "1.0.0",
  "description": "Keyword matching and scoring engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "dev:test": "tsx src/dev.ts",
    "dev:yaml": "tsx src/yaml-test.ts",
    "clean": "rimraf dist",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@news-agg/shared": "workspace:*",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.8",
    "tsup": "^8.0.0",
    "tsx": "^4.6.0",
    "rimraf": "^5.0.0",
    "vitest": "^1.0.0"
  }
}